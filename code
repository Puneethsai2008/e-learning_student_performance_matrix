# ---------------------------------------------------------------------
# 3. Server
# ---------------------------------------------------------------------
server <- function(input, output, session) {

  # ---- Data loading ------------------------------------------------
  raw <- reactive({
    path <- if (!is.null(input$upload)) input$upload$datapath else DATASETS[[input$dataset]]
    df <- read_students(path)
    miss <- setdiff(REQUIRED_COLS, names(df))
    validate(need(length(miss) == 0,
                  paste("Uploaded file is missing columns:", paste(miss, collapse = ", "))))
    df
  })

  full <- reactive(prep_data(raw()))

  # ---- Dynamic filters ---------------------------------------------
  output$filter_ui <- renderUI({
    d <- full()
    tagList(
      checkboxGroupInput("f_dept", "Department",
                         choices = sort(unique(d$Department)),
                         selected = sort(unique(d$Department))),
      checkboxGroupInput("f_gender", "Gender",
                         choices = sort(unique(d$Gender)),
                         selected = sort(unique(d$Gender))),
      sliderInput("f_age", "Age", min = min(d$Age), max = max(d$Age),
                  value = range(d$Age), step = 1),
      sliderInput("f_att", "Attendance (%)", min = 0, max = 100,
                  value = c(0, 100), step = 1)
    )
  })

  filtered <- reactive({
    req(input$f_dept, input$f_gender, input$f_age, input$f_att)
    d <- full() %>%
      filter(
        Department %in% input$f_dept,
        Gender %in% input$f_gender,
        Age >= input$f_age[1], Age <= input$f_age[2],
        is.na(Attendance) | (Attendance >= input$f_att[1] & Attendance <= input$f_att[2])
      )
    validate(need(nrow(d) > 0, "No students match the current filters."))
    d
  })

  at_risk <- reactive({
    filtered() %>%
      mutate(
        Reason = case_when(
          Total_Score < input$risk_score & !is.na(Attendance) & Attendance < input$risk_att ~ "Low score + low attendance",
          Total_Score < input$risk_score ~ "Low total score",
          !is.na(Attendance) & Attendance < input$risk_att ~ "Low attendance",
          TRUE ~ NA_character_
        )
      ) %>%
      filter(!is.na(Reason))
  })

  # ---- Overview ----------------------------------------------------
  output$vb_students <- renderValueBox({
    valueBox(comma(nrow(filtered())), "Students", icon = icon("users"), color = "blue")
  })
  output$vb_avg <- renderValueBox({
    valueBox(round(mean(filtered()$Total_Score, na.rm = TRUE), 1),
             "Average total score", icon = icon("star"), color = "aqua")
  })
  output$vb_pass <- renderValueBox({
    pass <- mean(filtered()$Total_Score >= 60, na.rm = TRUE)
    valueBox(percent(pass, accuracy = 0.1), "Pass rate (total >= 60)",
             icon = icon("circle-check"), color = "green")
  })
  output$vb_risk <- renderValueBox({
    n <- sum(filtered()$Performance_Level == "Needs Improvement", na.rm = TRUE)
    valueBox(comma(n), "Need improvement (total < 60)",
             icon = icon("triangle-exclamation"), color = "red")
  })

  output$p_grade <- renderPlot({
    filtered() %>%
      count(Grade) %>%
      ggplot(aes(Grade, n, fill = Grade)) +
      geom_col(width = 0.7, show.legend = FALSE) +
      geom_text(aes(label = comma(n)), vjust = -0.4) +
      scale_fill_manual(values = GRADE_COLORS) +
      scale_y_continuous(expand = expansion(mult = c(0, 0.12))) +
      labs(x = "Grade", y = "Students") + theme_dash()
  })

  output$p_dept <- renderPlot({
    filtered() %>%
      group_by(Department) %>%
      summarise(Avg = mean(Total_Score, na.rm = TRUE), .groups = "drop") %>%
      ggplot(aes(reorder(Department, Avg), Avg)) +
      geom_col(fill = "#3c8dbc", width = 0.7) +
      geom_text(aes(label = round(Avg, 1)), hjust = 1.2, colour = "white", fontface = "bold") +
      coord_flip() +
      labs(x = NULL, y = "Average total score") + theme_dash()
  })

  output$p_hist <- renderPlot({
    d <- filtered()
    ggplot(d, aes(Total_Score)) +
      geom_histogram(bins = 30, fill = "#3c8dbc", colour = "white") +
      geom_vline(xintercept = mean(d$Total_Score, na.rm = TRUE),
                 linetype = "dashed", colour = "#e53935", linewidth = 1) +
      labs(x = "Total score", y = "Students",
           subtitle = "Dashed line = mean") + theme_dash()
  })

  output$p_levels <- renderPlot({
    filtered() %>%
      count(Department, Performance_Level) %>%
      group_by(Department) %>% mutate(Share = n / sum(n)) %>% ungroup() %>%
      ggplot(aes(Department, Share, fill = Performance_Level)) +
      geom_col(width = 0.7) +
      scale_fill_manual(values = LEVEL_COLORS, name = NULL) +
      scale_y_continuous(labels = percent) +
      labs(x = NULL, y = "Share of students") + theme_dash()
  })

  # ---- Performance matrix -------------------------------------------
  output$p_matrix <- renderPlot({
    g <- input$matrix_group
    long <- filtered() %>%
      group_by(Group = .data[[g]]) %>%
      summarise(across(all_of(unname(COMPONENTS)), ~ mean(.x, na.rm = TRUE)),
                .groups = "drop") %>%
      pivot_longer(-Group, names_to = "Component", values_to = "Mean") %>%
      mutate(Component = factor(Component, levels = unname(COMPONENTS),
                                labels = names(COMPONENTS)))

    ggplot(long, aes(Component, Group, fill = Mean)) +
      geom_tile(colour = "white", linewidth = 1) +
      geom_text(aes(label = round(Mean, 1)), fontface = "bold") +
      scale_fill_gradient(low = "#fde0dd", high = "#7bccc4", name = "Avg") +
      scale_x_discrete(position = "top") +
      labs(x = NULL, y = NULL) +
      theme_dash() +
      theme(panel.grid = element_blank(), legend.position = "right")
  })

  output$t_matrix <- renderDT({
    score_cols <- c("Attendance", "Midterm_Score", "Final_Score", "Assignments_Avg",
                    "Quizzes_Avg", "Participation_Score", "Projects_Score", "Total_Score")
    tbl <- filtered() %>%
      select(Student_ID, Full_Name, Department, all_of(score_cols),
             Grade, Performance_Level)

    datatable(tbl, rownames = FALSE, filter = "top",
              options = list(pageLength = 10, scrollX = TRUE),
              colnames = c("ID", "Name", "Department", "Attendance", "Midterm",
                           "Final", "Assignments", "Quizzes", "Participation",
                           "Projects", "Total", "Grade", "Level")) %>%
      formatRound(score_cols, 1) %>%
      formatStyle(
        score_cols,
        backgroundColor = styleInterval(c(60, 70, 80),
                                        c("#f8d7da", "#fff3cd", "#d4edda", "#b7e4c7"))
      ) %>%
      formatStyle("Grade",
                  backgroundColor = styleEqual(names(GRADE_COLORS), unname(GRADE_COLORS)),
                  fontWeight = "bold") %>%
      formatStyle("Performance_Level",
                  backgroundColor = styleEqual(names(LEVEL_COLORS), unname(LEVEL_COLORS)))
  })

  # ---- Success factors ----------------------------------------------
  output$p_scatter <- renderPlot({
    x <- input$scatter_x
    d <- filtered() %>% filter(!is.na(.data[[x]]), !is.na(Total_Score))
    ggplot(d, aes(.data[[x]], Total_Score)) +
      geom_point(alpha = 0.25, colour = "#3c8dbc") +
      geom_smooth(method = "lm", formula = y ~ x, colour = "#e53935", se = TRUE) +
      labs(x = gsub("_", " ", x), y = "Total score") + theme_dash()
  })

  output$p_box <- renderPlot({
    x <- input$box_x
    ggplot(filtered(), aes(.data[[x]], Total_Score, fill = .data[[x]])) +
      geom_boxplot(show.legend = FALSE, alpha = 0.8, outlier.alpha = 0.3) +
      labs(x = gsub("_", " ", x), y = "Total score") + theme_dash() +
      theme(axis.text.x = element_text(angle = 20, hjust = 1))
  })

  cor_mat <- reactive({
    cor(filtered()[, NUMERIC_VARS], use = "pairwise.complete.obs")
  })

  output$p_corbar <- renderPlot({
    cm <- cor_mat()
    d <- data.frame(Variable = rownames(cm), r = cm[, "Total_Score"]) %>%
      filter(Variable != "Total_Score")
    ggplot(d, aes(reorder(Variable, r), r, fill = r > 0)) +
      geom_col(show.legend = FALSE) +
      geom_text(aes(label = sprintf("%.2f", r),
                    hjust = ifelse(r >= 0, -0.1, 1.1)), size = 3.5) +
      scale_fill_manual(values = c("TRUE" = "#2e7d32", "FALSE" = "#e53935")) +
      scale_y_continuous(expand = expansion(mult = 0.15)) +
      coord_flip() +
      labs(x = NULL, y = "Pearson correlation with Total_Score") + theme_dash()
  })

  output$p_cormat <- renderPlot({
    cm <- cor_mat()
    d <- as.data.frame(as.table(cm))
    names(d) <- c("V1", "V2", "r")
    ggplot(d, aes(V1, V2, fill = r)) +
      geom_tile(colour = "white") +
      geom_text(aes(label = sprintf("%.2f", r)), size = 2.8) +
      scale_fill_gradient2(low = "#e53935", mid = "white", high = "#1f78b4",
                           midpoint = 0, limits = c(-1, 1), name = "r") +
      labs(x = NULL, y = NULL) + theme_dash() +
      theme(axis.text.x = element_text(angle = 45, hjust = 1),
            panel.grid = element_blank(), legend.position = "right")
  })

  # ---- At-risk -------------------------------------------------------
  output$vb_risk_n <- renderValueBox({
    valueBox(comma(nrow(at_risk())), "Students flagged",
             icon = icon("triangle-exclamation"), color = "red")
  })
  output$vb_risk_pct <- renderValueBox({
    valueBox(percent(nrow(at_risk()) / nrow(filtered()), accuracy = 0.1),
             "Share of filtered students", icon = icon("percent"), color = "orange")
  })

  output$p_risk_dept <- renderPlot({
    validate(need(nrow(at_risk()) > 0, "No students flagged with these thresholds."))
    at_risk() %>%
      count(Department, Reason) %>%
      ggplot(aes(Department, n, fill = Reason)) +
      geom_col(width = 0.7) +
      scale_fill_brewer(palette = "Set2", name = NULL) +
      labs(x = NULL, y = "Students") + theme_dash() +
      guides(fill = guide_legend(nrow = 2))
  })

  risk_table <- reactive({
    at_risk() %>%
      select(Student_ID, Full_Name, Department, Attendance, Total_Score,
             Study_Hours_per_Week, Stress_Level, Reason) %>%
      arrange(Total_Score)
  })

  output$t_risk <- renderDT({
    datatable(risk_table(), rownames = FALSE,
              options = list(pageLength = 8, scrollX = TRUE),
              colnames = c("ID", "Name", "Department", "Attendance", "Total",
                           "Study hrs/wk", "Stress", "Reason")) %>%
      formatRound(c("Attendance", "Total_Score", "Study_Hours_per_Week"), 1)
  })

  output$dl_risk <- downloadHandler(
    filename = function() paste0("at_risk_students_", Sys.Date(), ".csv"),
    content  = function(file) write.csv(risk_table(), file, row.names = FALSE)
  )

  # ---- Data explorer -------------------------------------------------
  output$p_missing <- renderPlot({
    miss <- colSums(is.na(full()))
    d <- data.frame(Column = names(miss), Missing = as.numeric(miss)) %>%
      filter(Missing > 0)
    validate(need(nrow(d) > 0, "No missing values in this dataset."))
    ggplot(d, aes(reorder(Column, Missing), Missing)) +
      geom_col(fill = "#fb8c00", width = 0.7) +
      geom_text(aes(label = comma(Missing)), hjust = -0.1) +
      scale_y_continuous(expand = expansion(mult = c(0, 0.15))) +
      coord_flip() +
      labs(x = NULL, y = "Missing values") + theme_dash()
  })

  output$t_data <- renderDT({
    datatable(filtered() %>% select(-Full_Name, -Age_Group),
              rownames = FALSE, filter = "top",
              options = list(pageLength = 10, scrollX = TRUE))
  })

  output$dl_data <- downloadHandler(
    filename = function() paste0("filtered_students_", Sys.Date(), ".csv"),
    content  = function(file) {
      write.csv(filtered() %>% select(-Full_Name, -Age_Group), file, row.names = FALSE)
    }
  )
}

shinyApp(ui, server)
