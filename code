# ---------------------------------------------------------------------
# 1. Constants & helpers
# ---------------------------------------------------------------------
DATASETS <- c(
  "Students Performance Dataset"      = "data/students_performance.csv",
  "Students Grading Dataset (Biased)" = "data/students_grading_biased.csv"
)

REQUIRED_COLS <- c(
  "Student_ID", "First_Name", "Last_Name", "Gender", "Age", "Department",
  "Attendance (%)", "Midterm_Score", "Final_Score", "Assignments_Avg",
  "Quizzes_Avg", "Participation_Score", "Projects_Score", "Total_Score",
  "Grade", "Study_Hours_per_Week", "Extracurricular_Activities",
  "Internet_Access_at_Home", "Parent_Education_Level", "Family_Income_Level",
  "Stress_Level (1-10)", "Sleep_Hours_per_Night"
)

GRADE_COLORS <- c(A = "#2e7d32", B = "#66bb6a", C = "#fdd835",
                  D = "#fb8c00", F = "#e53935")
LEVEL_COLORS <- c("Excellent" = "#2e7d32", "Good" = "#9ccc65",
                  "Average" = "#fdd835", "Needs Improvement" = "#e53935")

# Assessment components shown in the Performance Matrix (all on a 0-100 scale)
COMPONENTS <- c(
  "Attendance"    = "Attendance",
  "Midterm"       = "Midterm_Score",
  "Final"         = "Final_Score",
  "Assignments"   = "Assignments_Avg",
  "Quizzes"       = "Quizzes_Avg",
  "Participation" = "Participation_Score",
  "Projects"      = "Projects_Score",
  "Total"         = "Total_Score"
)

NUMERIC_VARS <- c(
  "Age", "Attendance", "Midterm_Score", "Final_Score", "Assignments_Avg",
  "Quizzes_Avg", "Participation_Score", "Projects_Score", "Total_Score",
  "Study_Hours_per_Week", "Stress_Level", "Sleep_Hours_per_Night"
)

read_students <- function(path) {
  read.csv(path, check.names = FALSE, stringsAsFactors = FALSE,
           na.strings = c("", "NA"))
}

prep_data <- function(df) {
  names(df)[names(df) == "Attendance (%)"]      <- "Attendance"
  names(df)[names(df) == "Stress_Level (1-10)"] <- "Stress_Level"

  df %>%
    mutate(
      Grade = factor(Grade, levels = c("A", "B", "C", "D", "F")),
      Performance_Level = cut(
        Total_Score,
        breaks = c(-Inf, 60, 70, 80, Inf),
        labels = c("Needs Improvement", "Average", "Good", "Excellent"),
        right  = FALSE
      ),
      Parent_Education_Level = factor(
        ifelse(is.na(Parent_Education_Level), "Not Reported", Parent_Education_Level),
        levels = c("Not Reported", "None", "High School", "Bachelor's", "Master's", "PhD")
      ),
      Family_Income_Level = factor(Family_Income_Level,
                                   levels = c("Low", "Medium", "High")),
      Age_Group = cut(Age, breaks = c(0, 19, 21, 100),
                      labels = c("18-19", "20-21", "22+")),
      Full_Name = paste(First_Name, Last_Name)
    )
}

theme_dash <- function() {
  theme_minimal(base_size = 13) +
    theme(
      plot.title      = element_text(face = "bold", size = 14),
      panel.grid.minor = element_blank(),
      legend.position = "bottom"
    )
}

